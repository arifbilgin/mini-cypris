          "body": "{\n  \"db\": \"ok\",\n  \"status\": \"ok\",\n  \"tables\": [\n    \"aggregates\",\n    \"papers\",\n    \"search_results\",\n    \"searches\"\n  ],\n  \"version\": \"0.1.0\"\n}"
        }
      ]
