    {
      "name": "Search",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/search?q=drone AND (package OR delivery)&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "drone AND (package OR delivery)"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        },
        "description": "Top `limit` papers (1-100, default 10) for a boolean query, served through the SQLite cache. `X-Cache` / `cache.status` says how: MISS (fetched from CORE), HIT (from SQLite), TOPUP (fetched only the missing rows), REFRESH (older than 24 h, fetched again), STALE or PARTIAL (CORE failed, served what was cached)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"X-Cache says how it was served\", () => pm.expect([\"MISS\",\"HIT\",\"TOPUP\",\"REFRESH\",\"STALE\",\"PARTIAL\"]).to.include(pm.response.headers.get(\"X-Cache\")));",
              "pm.test(\"at most limit results\", () => { pm.expect(body.count).to.be.at.most(5); pm.expect(body.results.length).to.eql(body.count); });",
              "pm.test(\"total_hits counts all of CORE\", () => pm.expect(body.total_hits).to.be.at.least(body.count));",
              "pm.test(\"paper shape\", () => body.results.forEach(p => pm.expect(p).to.have.all.keys(\"id\",\"source\",\"external_id\",\"title\",\"authors\",\"year\",\"publisher\",\"doi\",\"pdf_url\",\"abstract\")));",
              "pm.test(\"query normalized\", () => pm.expect(body.query).to.eql(\"drone AND (package OR delivery)\"));"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 OK",
