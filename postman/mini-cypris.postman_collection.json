{
  "info": {
    "_postman_id": "d673a673-140e-5d0e-a7de-499e28f66912",
    "name": "Mini-Cypris API",
    "description": "Flask API in front of the CORE research-paper API. Set `baseUrl` with an environment: Local dev (8000) or Docker (8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Service and database status. Lists the SQLite tables created from schema.sql."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));",
              "pm.test(\"schema created\", () => pm.expect(pm.response.json().tables).to.include.members([\"papers\",\"searches\",\"search_results\",\"aggregates\"]));"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
